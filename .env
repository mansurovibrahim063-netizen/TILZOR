# Telegram Bot sozlamalari
BOT_TOKEN=
ADMIN_TELEGRAM_ID=0

# Google Gemini AI sozlamalari
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Web Admin Panel sozlamalari
WEB_HOST=127.0.0.1
WEB_PORT=8000
ADMIN_PASSWORD=admin123
SECRET_KEY=super-secret-key-change-me

# Ma'lumotlar bazasi
DATABASE_URL=sqlite+aiosqlite:///./moderator.db

# Moderatsiya qoidalari
AUTO_TRANSLATE=true
STRICT_LINK_BLOCKING=true
TOXICITY_THRESHOLD=65
ENABLE_FLOOD_PROTECTION=true
FLOOD_WINDOW_SECONDS=60
FLOOD_MAX_IDENTICAL_MESSAGES=2
